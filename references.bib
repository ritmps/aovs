@article{wijntjesLookWhatHave2008,
  title = {Look What {{I}} Have Felt: {{Unidentified}} Haptic Line Drawings Are Identified after Sketching},
  shorttitle = {Look What {{I}} Have Felt},
  author = {Wijntjes, Maarten W.A. and {van Lienen}, Thijs and Verstijnen, Ilse M. and Kappers, Astrid M.L.},
  year = 2008,
