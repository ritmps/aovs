@article{meyerDisfluentFontsDont2015,
  title = {Disfluent Fonts Don't Help People Solve Math Problems.},
  author = {Meyer, Andrew and Frederick, Shane and Burnham, Terence C and Guevara Pinto, Juan D and Boyer, Ty W and Ball, Linden J and Pennycook, Gordon and Ackerman, Rakefet and Thompson, Valerie A and Schuldt, Jonathon P},
