@article{recanzoneDynamicChangesFunctional1993a,
  title = {Dynamic {{Changes}} in the {{Functional Organization}} of the {{Cerebral Cortex Are Correlated}} with {{Changes}} in {{Psychophysically Measured Perceptual Acuity}}},
