@article{mcdonaldInvoluntaryOrientingSound2000,
  title = {Involuntary Orienting to Sound Improves Visual Perception.},
  author = {McDonald, J J and {Teder-S{\"a}lej{\"a}rvi}, W A and Hillyard, S A},
