  keywords = {Computer Science - Computer Vision and Pattern Recognition},
  file = {/Users/fxpppr/Zotero/storage/5UVQ9PPB/Luiten et al. - 2023 - Dynamic 3D Gaussians Tracking by Persistent Dynamic View Synthesis.pdf;/Users/fxpppr/Zotero/storage/KMKH3VHH/Luiten et al. - 2023 - Dynamic 3D Gaussians Tracking by Persistent Dynamic View Synthesis.pdf;/Users/fxpppr/Zotero/storage/BXJFJU5C/2308.html;/Users/fxpppr/Zotero/storage/IEXDYSAA/dynamic3dgaussians.github.io.html}
