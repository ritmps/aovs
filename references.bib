  shorttitle = {Atropine for the {{Treatment}} of {{Childhood Myopia}}},
  author = {Tong, Louis and Huang, Xiao Ling and Koh, Angeline L.T. and Zhang, Xiaoe and Tan, Donald T.H. and Chua, Wei-Han},
