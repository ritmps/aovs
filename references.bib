@article{dimarcoDecodingEvolutionMelodic2026,
  title = {Decoding the Evolution of Melodic and Harmonic Structure of {{Western}} Music through the Lens of Network Science},
  author = {Di Marco, Niccol{\`o} and Loru, Edoardo and Galeazzi, Alessandro and Cinelli, Matteo and Quattrociocchi, Walter},
  year = 2026,
