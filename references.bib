@article{longuet-higginsEigenfunctionsLaplacesTidal1968,
  title = {The {{Eigenfunctions}} of {{Laplace}}'s {{Tidal Equations}} over a {{Sphere}}},
  author = {{Longuet-Higgins}, M. S.},
  year = 1968,
  journal = {Philosophical Transactions of the Royal Society of London. Series A, Mathematical and Physical Sciences},
  volume = {262},
  number = {1132},
  eprint = {73582},
  eprinttype = {jstor},
  pages = {511--607},
  publisher = {The Royal Society},
  issn = {0080-4614},
  urldate = {2026-02-06},
  abstract = {Numerical calculations are presented for the eigenvalues of Laplace's tidal equations governing a thin layer of fluid on a rotating sphere, for a complete range of the parameter {$\varepsilon$} = 4\textohm{} \textsuperscript{2}R\textsuperscript{2}/gh (\textohm{} = rate of rotation, R = radius, g = gravity, h = depth of fluid layer). The corresponding eigenfunctions or `Hough functions' are shown graphically for the lower modes of oscillation. Negative values of {$\varepsilon$} , which have application in problems involving forced motions, are also considered. The calculations reveal many asymptotic forms of the solution for various limiting values of {$\varepsilon$} . The corresponding analytical expressions are derived in the present paper. Thus, as {$\varepsilon$} {$\rightarrow$} 0 through positive values we have the well-known waves of the first and second class respectively, which were found by Margules and Hough. These can be represented in terms of spherical harmonics. As {$\varepsilon$} {$\rightarrow$} + {$\infty$} there are three distinct asymptotic forms. In each of these the energy is concentrated near the equator. In the first type, the kinetic energy is three times the potential energy. In the other two types the kinetic and potential energies are equal. The waves of the second type are all propagated towards the west. The waves of the third type are Kelvin waves propagated eastwards along the equator. All three types are described in terms of Hermite polynomials. As {$\varepsilon$} {$\rightarrow$} 0 through negative values there is only one asymptotic form of solution, representing motions which are analytically continuous with Hough's `waves of the second class'. As {$\varepsilon$} {$\rightarrow$} - {$\infty$} there are three different asymptotic forms, in each of which the energy tends to be concentrated near the poles of rotation. In the first two types the energy is mainly kinetic and the motion is in inertial circles. In the third type the energy is mainly potential. The modes tend to occur in pairs of almost the same frequency, one being symmetric and the other antisymmetric about the equator. The analytical forms of the solutions involve generalized Laguerre polynomials. In the special case of zonal oscillations, the first two limiting forms as {$\varepsilon$} {$\rightarrow$} - {$\infty$} go over into a different form in which the frequency tends to zero as {$\varepsilon$} tends to a finite negative value. In this case the third type does not occur. The way in which the various asymptotic solutions are connected can be traced in figures 1 to 6 ({$\varepsilon$} {$>$} 0) and figures 16 to 21 ({$\varepsilon$} {$<$} 0). Accurate values of the eigenfrequencies, covering the range -10\textsuperscript{4} {$<$} {$\varepsilon$} {$<$} 10\textsuperscript{4} are tabulated in tables 1 to 10. The eigenfunctions for the lower modes are presented graphically.},
  file = {/Users/fxpppr/Zotero/storage/2EYHB499/Longuet-Higgins - 1968 - The Eigenfunctions of Laplace's Tidal Equations over a Sphere.pdf}
}

