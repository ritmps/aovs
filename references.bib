  file = {/Users/fxpppr/Zotero/storage/VTSP3EYV/Gosztolai et al. - 2020 - LiftPose3D, a deep learning-based approach for tra.pdf;/Users/fxpppr/Zotero/storage/J23ECEA3/2020.09.18.html}
