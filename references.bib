@article{panProgressiveAtrophyOptic2007,
  title = {Progressive Atrophy in the Optic Pathway and Visual Cortex of Early Blind {{Chinese}} Adults: {{A}} Voxel-Based Morphometry Magnetic Resonance Imaging Study},
