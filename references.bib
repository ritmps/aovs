@article{ennisGeometricalStructurePerceptual2019,
  title = {Geometrical Structure of Perceptual Color Space: {{Mental}} Representations and Adaptation Invariance},
  shorttitle = {Geometrical Structure of Perceptual Color Space},
  author = {Ennis, Robert J. and Zaidi, Qasim},
  year = 2019,
  month = oct,
  journal = {Journal of Vision},
  volume = {19},
