@article{pienkowskiEtiologyListeningDifficulties2017,
  title = {On the {{Etiology}} of {{Listening Difficulties}} in {{Noise Despite Clinically Normal Audiograms}}},
  author = {Pienkowski, Martin},
  year = 2017,
