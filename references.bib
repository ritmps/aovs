@article{yildirimTransferObjectCategory2013,
  title = {Transfer of Object Category Knowledge across Visual and Haptic Modalities: {{Experimental}} and Computational Studies},
  shorttitle = {Transfer of Object Category Knowledge across Visual and Haptic Modalities},
  author = {Yildirim, Ilker and Jacobs, Robert A.},
  year = 2013,
  month = feb,
  journal = {Cognition},
  volume = {126},
