@article{barendsDigitizedAdiabaticQuantum2016,
  title = {Digitized Adiabatic Quantum Computing with a Superconducting Circuit.},
  author = {Barends, R and Shabani, A and Lamata, L and Kelly, J and Mezzacapo, A and Las Heras, U and Babbush, R and Fowler, A G and Campbell, B and Chen, Yu and Chen, Z and Chiaro, B and Dunsworth, A and Jeffrey, E and Lucero, E and Megrant, A and Mutus, J Y and Neeley, M and Neill, C and O'Malley, P J J and Quintana, C and Roushan, P and Sank, D and Vainsencher, A and Wenner, J and White, T C and Solano, E and Neven, H and Martinis, John M},
  year = 2016,
