@article{phillipsVeiledVirginEffecta,
  title = {The {{Veiled Virgin Effect}}: {{Visual Segmentation}} of {{Shape}} into {{Causal Layers}}},
  author = {Phillips, Flip and Fleming, Roland W},
  journal = {Submitted: PNAS},
  pages = {14},
  abstract = {Shape perception is one of the most important functions of vision. It is crucial for many tasks, from object recognition to tool use, yet how the brain represents shape remains poorly understood. Most theories focus on purely geometrical computations (e.g., estimating depths, curvatures, symmetries). Here, however, we find that shape perception also involves sophisticated causal inferences that decompose shapes into multiple, superimposed 'causal layers'. Inspired by marble sculptures such as Strazza's Veiled Virgin (1850), which vividly depict figures swathed in cloth, we created composite shapes by wrapping unfamiliar forms in textile, so that the observable surface relief was the result of complex interactions between the underlying object and overlying fabric. Making sense of such structures requires segmenting the shape based on their causes, to distinguish whether lumps and ridges are due to the shrouded object or to the ripples and folds of the overlying cloth. 3D scans of the objects with and without the textile provided ground truth measures of the true physical surface reliefs, against which observers' judgments could be compared. In a virtual painting task, participants indicated which surface ridges appeared to be caused by the hidden object, and which were due to the drapery. In another experiment, they also indicated the perceived depth profile of both surface layers. Their responses reveal that they can robustly distinguish between superimposed causes. Together, these findings reveal the operation of previously unknown visual shape segmentation computations, which parse shapes based on their causal origin.},
  copyright = {All rights reserved},
  langid = {english},
  keywords = {No DOI found},
  file = {/Users/fxpppr/Zotero/storage/BPBIBPLT/Veiled-Virgin-R1-AuthorPDF.pdf;/Users/fxpppr/Zotero/storage/QFES3HC9/Phillips and Fleming - The Veiled Virgin Effect Visual Segmentation of S.pdf;/Users/fxpppr/Zotero/storage/UASKT9RP/PNAS_201917565_s1.pdf;/Users/fxpppr/Zotero/storage/Y9HQKZAT/ProofPDF_PNAS_201917565.pdf}
}

