@article{roweisNonlinearDimensionalityReduction2000,
  title = {Nonlinear Dimensionality Reduction by Locally Linear Embedding.},
  author = {Roweis, S T and Saul, L K},
  year = 2000,
  month = dec,
  journal = {Science},
