@article{ivoImprovedSilhouetteRendering2020,
  title = {Improved Silhouette Rendering and Detection of Splat-Based Models},
  author = {Ivo, Rafael Fernandes and Vidal, Creto Augusto and {Cavalcante-Neto}, Joaquim Bento},
  year = 2020,
