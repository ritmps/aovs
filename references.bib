@article{vicenteLeaveOneOutKernelOptimization2018,
  title = {Leave-{{One-Out Kernel Optimization}} for {{Shadow Detection}} and {{Removal}}},
  author = {Vicente, Tom{\'a}s F. Yago and Hoai, Minh and Samaras, Dimitris},
  year = 2018,
