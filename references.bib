@misc{liSpacetimeGaussianFeature2023,
  title = {Spacetime {{Gaussian Feature Splatting}} for {{Real-Time Dynamic View Synthesis}}},
  author = {Li, Zhan and Chen, Zhang and Li, Zhong and Xu, Yi},
