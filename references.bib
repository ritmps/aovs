@article{yenEffectsVirtualReality2011,
  title = {Effects of {{Virtual Reality}}--{{Augmented Balance Training}} on {{Sensory Organization}} and {{Attentional Demand}} for {{Postural Control}} in {{People With Parkinson Disease}}: {{A Randomized Controlled Trial}}},
  author = {Yen, Chang-Yi and Lin, Kwan-Hwa and Hu, Ming-Hsia and Wu, Ruey-Meei and Lu, Tung-Wu and Lin, Chia-Hwa},
  year = 2011,
