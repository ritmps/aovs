@article{havranLightdrumPortableLight2017,
  title = {Lightdrum---{{Portable Light Stage}} for {{Accurate BTF Measurement}} on {{Site}}},
  author = {Havran, Vlastimil and Ho{\v s}ek, Jan and N{\v e}mcov{\'a}, {\v S}{\'a}rka and {\v C}{\'a}p, Ji{\v r}{\'i} and Bittner, Ji{\v r}{\'i}},
