  title = {What the {{Frog}}'s {{Eye Tells}} the {{Frog}}'s {{Brain}}},
  author = {Lettvin, J. and Maturana, H. and McCulloch, W. and Pitts, W.},
  year = 1959,
  month = nov,
  journal = {Proceedings of the IRE},
