  author = {{Duran-Martin}, Gerardo and Altamirano, Matias and Shestopaloff, Alexander Y. and {S{\'a}nchez-Betancourt}, Leandro and Knoblauch, Jeremias and Jones, Matt and Briol, Fran{\c c}ois-Xavier and Murphy, Kevin},
  year = 2024,
