  langid = {english},
  file = {/Users/fxpppr/Zotero/storage/FP52WFGU/Mangalam - 2025 - THE EXIT MANUAL HOW TO LEAVE THE FREE ENERGY CULT AND STILL GET TENURE.pdf}
