@article{schmidtPerceptualPlausibilityExaggerated,
  title = {Perceptual Plausibility of Exaggerated Realistic Motion},
  author = {Schmidt, Filipp and Noejovich, Laura and Chakalos, George and Phillips, Flip},
  pages = {9},
  abstract = {The informal heuristic practices of the fine arts have much to o↵er to our understanding of the appearance of phenomenological reality. One interesting example is the use of exaggeration to mitigate uncanny valley phenomena in animation. Animated motion is frequently exaggerated to give objects `life' so as to appear less uncanny. We performed a series of experiments to test the e↵ects of exaggeration on the phenomenological perception of simple animated objects --- bouncing balls. A physically plausible model of a bouncing ball was augmented with a frequently used form of exaggeration known as squash and stretch. Informants were shown a series of animated balls, depicted using systematic parameterizations of the exaggeration model, and asked to rate their plausibility. A range of rendering styles provided varying levels of information as to the type of ball. In all cases, balls with no exaggeration (e.g., with veridical motion) were seen as significantly less plausible than those with it. Furthermore, when the type of ball was not specified, subjects tolerated a large amount of exaggeration before judging them as implausible. When the type of ball was indicated, subjects narrowed the range of acceptable exaggeration somewhat but still tolerated exaggeration well beyond that which would be physically possible. We contend that, in this case, exaggeration acts to bridge the uncanny valley for artificial depictions of physical reality.},
  langid = {english},
  keywords = {Cartoon Animation,Computer Animation,Material perception,Motion perception,Squash-and-stretch},
  file = {/Users/fxpppr/Zotero/storage/8T5TDAY6/Schmidt et al. - Perceptual plausibility of exaggerated realistic motion.pdf;/Users/fxpppr/Zotero/storage/C42FAWGG/Schmidt et al. - Perceptual plausibility of exaggerated realistic motion.pdf;/Users/fxpppr/Zotero/storage/CW3MHRCC/Schmidt et al. - 2024 - Perceptual plausibility of exaggerated realistic motion.pdf;/Users/fxpppr/Zotero/storage/HW397MAD/Schmidt et al. - Perceptual plausibility of exaggerated realistic m.pdf;/Users/fxpppr/Zotero/storage/WGZ9DH8R/Schmidt et al. - Perceptual plausibility of exaggerated realistic motion.pdf}
