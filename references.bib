@article{castilloCardiacHypothesisOrigin1983,
  title = {A {{Cardiac Hypothesis}} for the {{Origin}} of {{EEG Alpha}}},
  author = {Castillo, Horace T.},
  year = 1983,
  month = dec,
  journal = {IEEE Transactions on Biomedical Engineering},
  volume = {BME-30},
  number = {12},
  pages = {793--796},
  issn = {1558-2531},
  doi = {10.1109/TBME.1983.325080},
  abstract = {Major hypotheses for the origin of EEG alpha suggest a neural basis, but omit to consider other electrical and mechanical aspects. A cardiac electromechanical hypothesis is proposed. This hypothesis suggests that the natural mechanical frequency of the skull-brain mass is approximately 10 Hz. This has been determined by model and direct measurement. Membrane, liquid junction, electrode, and static charges exist as nonneural sources of potential in EEG recording. These standing potentials can be modulated by pressure and movement. It is postulated that the arterial pulse shocks the brain mass into oscillation at its natural frequency modulating the nonneural potentials. The arterial pulse has a jitter as great as \textpm 720 electrical degrees at 10 Hz and amplitude jitter of approximately \textpm 10 mmHg. Because of cardiac jitter, the differential aspect of amplification, and mixing of waves in the skull, coherence of alpha with phase of the cardiac cycle could not be demonstrated. The cardiac electromechanical hypothesis may assist others in designing experiments that will establish a valid explanation for the origin of EEG alpha.},
  keywords = {Adult,Biomedical Engineering,Biomembranes,Brain,Brain modeling,Electric shock,Electrocardiography,Electrodes,Electroencephalography,Female,Frequency measurement,Heart,Humans,Jitter,Male,Mechanical variables measurement,Models Biological,Neural Conduction,Pulse,Pulse amplifiers,Pulse modulation},
  file = {/Users/fxpppr/Zotero/storage/XTQS2ZZT/Castillo - 1983 - A Cardiac Hypothesis for the Origin of EEG Alpha.pdf;/Users/fxpppr/Zotero/storage/SMEI2NZA/4121556.html}
