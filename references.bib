@article{deweyPredictableSelfinitiatedVisual2013,
  title = {Predictable and Self-Initiated Visual Motion Is Judged to Be Slower than Computer Generated Motion},
  author = {Dewey, J. A. and Carr, T. H.},
  year = 2013,
  month = sep,
  journal = {Conscious Cogn},
  edition = {2013/07/23},
  volume = {22},
  number = {3},
