  keywords = {blindsight,consciousness,dorsal stream,visual pathways,visuomotor control},
  file = {/Users/fxpppr/Zotero/storage/K86RNEQ6/Striemer et al. - 2009 - “Real-time” obstacle avoidance in the absence of p.pdf;/Users/fxpppr/Zotero/storage/CFSB7W2F/0905549106.html}
