  author = {Haghiashtiani, Ghazaleh and Qiu, Kaiyan and Sanchez, Jorge D. Zhingre and Fuenning, Zachary J. and Nair, Priya and Ahlberg, Sarah E. and Iaizzo, Paul A. and McAlpine, Michael C.},
