@article{padhyeVisualPerceptionSurface2021,
  title = {Visual Perception of Surface Properties through Direct Manipulation},
  author = {Padhye, Snehal and Doerschner, Katja and Phillips, Flip and Ferwerda, James},
  year = 2021,
  month = sep,
  journal = {Journal of Vision},
