@article{burridgeStatisticalPhysicsLanguage2018,
  title = {Statistical {{Physics}} of {{Language Maps}} in the {{USA}}},
  author = {Burridge, James and Vaux, Bert and Gnacik, Michal and Grudeva, Yoana},
