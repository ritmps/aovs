@article{khaliliInterpolationUsingGaussian2021,
  title = {Interpolation Using {{Gaussian}} Radial Basis Functions with Optimized Shape Parameter Applied in Vertical Deformation Analysis},
  author = {Khalili, M. A. and Voosoghi, B.},
  year = 2021,
  month = jun,
  journal = {Geodesy and Geodynamics},
  issn = {1674-9847},
  doi = {10.1016/j.geog.2021.02.004},
  urldate = {2021-06-15},
  abstract = {Many engineering and geology problems require the partial derivatives of scattered data points computed via interpolation methods. In this paper, interpolation using Gaussian Radial Basis Functions (GRBF) is proposed to interpolate and differentiate the scattered data applicable in the vertical deformation analysis. For the optimal selection of the shape parameter that is crucial in the GRBF interpolation, two methods are used that have been proposed successfully in the literature, namely, the power function (PGRBF) and Leave One Out Cross Validation (LOOCV) (LGRBF). We compared the accuracy of PGRBF and LGRBF to the traditional interpolation methods such as the Finite Element Method (FEM), polynomials, Moving Least Squares (MLS), and the usual GRBF in both simulated and real data. For the simulated data with a known mathematical function, the error values are estimated 1.77\texttimes 10-5, 1.47\texttimes 10-5, 4.6\texttimes 10-3, 1.1\texttimes 10-4, 4.0\texttimes 10-3, 7.0\texttimes 10-4, respectively, for the methods as mentioned above. The estimated accuracy showed that the surface interpolation accuracy had been improved by LGRBF and PGRBF methods up to 10 times compared to FEM, polynomial, and MLS methods. For the real vertical displacement data obtained by Interferometric Synthetic Aperture Radar (InSAR), it is observed that the accuracies of LGRBF and PGRBF methods are 93\% and 72\% better compared to the FEM, 100\% and 98\% better compared to MLS and 99\% and 98\% better compared to the polynomials. Finally, LGRBF and PGRBF interpolations compute invariant vertical deformation parameters, i.e., changes in Gaussian and mean Curvatures in the Groningen area in the North of the Netherlands.},
  langid = {english},
  keywords = {FEM,GRBF,InSAR,Interpolation,nosource,Vertical deformation analysis}
}

@article{khanAutomaticShadowDetection2016,
