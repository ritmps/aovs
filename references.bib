@article{gilrodriguezColourCalibrationHead2021,
  title = {Colour {{Calibration}} of a {{Head Mounted Display}} for {{Colour Vision Research Using Virtual Reality}}},
  author = {Gil Rodr{\'i}guez, Raquel and Bayer, Florian and Toscani, Matteo and Guarnera, Dar'ya and Guarnera, Giuseppe Claudio and Gegenfurtner, Karl R.},
  year = 2021,
  month = oct,
  journal = {SN Computer Science},
  volume = {3},
