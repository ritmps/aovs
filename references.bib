@article{ghomeshiContrastiveFocusReduplication2004a,
  title = {Contrastive {{Focus Reduplication}} in {{English}} ({{The Salad-Salad Paper}})},
  author = {Ghomeshi, Jila and Jackendoff, Ray and Rosen, Nicole and Russell, Kevin},
  year = 2004,
